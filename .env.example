# Kuyash — environment template (copy to .env; .env is gitignored, never commit it)
# Placeholder names only. No real secrets in this file — ever.
#
# Secure-by-default: debug stays OFF here so a blind `cp .env.example .env`
# on a server never exposes stack traces. For local development set
# APP_ENV=dev and APP_DEBUG=true in your own .env.

APP_NAME=Kuyash
APP_ENV=prod
APP_DEBUG=false
APP_URL=http://localhost:8080

# SQLite database file (optional override; defaults to storage/database/kuyash.sqlite)
# DB_PATH=

# Content Library (Phase 3) — optional overrides; app caps must stay BELOW
# post_max_size/upload_max_filesize or oversize uploads hit a generic 403
# LIBRARY_MAX_VIDEO_BYTES=209715200
# LIBRARY_MAX_PHOTO_BYTES=20971520
# LIBRARY_STORAGE_ROOT=

# Script & Caption Engine (Phase 5) — OpenAI text generation.
# MOCK-FIRST: leave OPENAI_MOCK=true (or unset the key) and the app uses the
# deterministic offline mock. Set OPENAI_MOCK=false AND a real key to enable
# live calls. NEVER commit a real key — .env is gitignored.
OPENAI_MOCK=true
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=30

# Trend Radar (Phase 6) — niche trend discovery.
# MOCK-FIRST: leave TREND_MOCK=true and the app uses the deterministic offline
# mock provider. Set TREND_MOCK=false to enable a real provider:
#   TREND_PROVIDER=youtube       → needs YOUTUBE_API_KEY (Data API v3)
#   TREND_PROVIDER=google_trends → public daily-trends endpoint, no key
# A missing/misconfigured real provider falls back to mock (fail-safe).
TREND_MOCK=true
# TREND_PROVIDER=youtube
# YOUTUBE_API_KEY=
# TREND_CACHE_TTL=21600
# TREND_LIMIT=8
# TREND_TIMEOUT=15

# Media Production (Phase 7) — TTS + stock + ffmpeg assembly.
# ffmpeg/ffprobe are LOCAL binaries (real by default). The mock TTS/stock
# providers feed REAL ffmpeg real inputs, so a full draft+final render works
# offline. Set TTS_MOCK=false (+ OPENAI_API_KEY) for real OpenAI speech;
# STOCK_MOCK=false (+ PEXELS_API_KEY) for real Pexels footage.
# Both binaries default to a bare name resolved from PATH (absolute PATH entries
# only, never the working directory), so a normal macOS/Linux install needs no
# setting here. Uncomment with an ABSOLUTE path to pin a specific build, or when
# the web/worker process runs with a PATH that does not include it.
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# FFPROBE_BIN=/usr/local/bin/ffprobe
# FFMPEG_TIMEOUT=900
TTS_MOCK=true
STOCK_MOCK=true
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# PEXELS_API_KEY=
# Burned-in captions need an ffmpeg built with libass/libfreetype; otherwise the
# SRT is a sidecar + soft mov_text track. Flip only on a capable build.
# BURN_SUBTITLES=false

# Storage (Phase 8) — durable storage + serving abstraction.
# DEFAULT 'local': objects on local disk, served by the authed range-stream route
# (Phase 7 behavior, unchanged). Set STORAGE_DRIVER=r2 ONLY after a Cloudflare R2
# bucket exists and the live-bucket smoke is cleared — the bucket must be PRIVATE
# (objects are served via short-TTL presigned redirects, never a public ACL).
# Backfill local→r2: php bin/migrate-storage.php --disk=r2 --workspace=all
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PRESIGN_TTL=300
# R2_MAX_DOWNLOAD_BYTES=536870912

# Publishing (Phase 10) — Zernio. The REAL adapter is implemented (schemas verified
# against the live openapi.yaml — see ADR-021). MOCK-FIRST: leave ZERNIO_MOCK=true and
# the deterministic mock provider runs (success + all 8 failure modes), NO live publish.
# Set ZERNIO_MOCK=false (+ ZERNIO_API_KEY) to publish for real. The endpoint INCLUDES
# the version segment. No OAuth tokens/passwords are ever stored (Zernio owns them);
# Kuyash keeps an account reference + health only.
ZERNIO_MOCK=true
# ZERNIO_ENDPOINT=https://zernio.com/api/v1
# ZERNIO_API_KEY=sk_...
# ZERNIO_TIMEOUT=30
# HMAC-SHA256 secret used to verify inbound Zernio webhook signatures. Empty =
# fail-closed (every delivery is rejected). Set a strong value to exercise the
# webhook inbox; required in production. NEVER commit a real secret.
# ZERNIO_WEBHOOK_SECRET=

# AI image-to-video (Phase 12, Quick Create) — DOC-GATED, like Zernio. Leave
# VIDEO_MOCK=true and the offline ffmpeg zoompan mock runs (real 9:16 clip, $0
# spend, AI-labeled). Setting VIDEO_MOCK=false (+ FAL_API_KEY) builds the real
# fal.ai-class adapter, which THROWS "doc-gated" until the items in
# .claude/docs/ai-video-notes.md are supplied — it never makes a live call.
# Generation is credit-gated by the per-workspace monthly budget cap.
VIDEO_MOCK=true
# FAL_API_KEY=
# VIDEO_MODEL=image-to-video
# VIDEO_ENDPOINT=
# VIDEO_TIMEOUT=120
# VIDEO_DEFAULT_SECONDS=16
# VIDEO_MAX_SECONDS=30
