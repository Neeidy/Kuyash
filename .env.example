# Kuyash — environment template (copy to .env; .env is gitignored, never commit it)
# Placeholder names only. No real secrets in this file — ever.
#
# Secure-by-default: debug stays OFF here so a blind `cp .env.example .env`
# on a server never exposes stack traces. For local development set
# APP_ENV=dev and APP_DEBUG=true in your own .env.

APP_NAME=Kuyash
APP_ENV=prod
APP_DEBUG=false
APP_URL=http://localhost:8080

# SQLite database file (optional override; defaults to storage/database/kuyash.sqlite)
# DB_PATH=

# Content Library (Phase 3) — optional overrides; app caps must stay BELOW
# post_max_size/upload_max_filesize or oversize uploads hit a generic 403
# LIBRARY_MAX_VIDEO_BYTES=209715200
# LIBRARY_MAX_PHOTO_BYTES=20971520
# LIBRARY_STORAGE_ROOT=

# Script & Caption Engine (Phase 5) — OpenAI text generation.
# MOCK-FIRST: leave OPENAI_MOCK=true (or unset the key) and the app uses the
# deterministic offline mock. Set OPENAI_MOCK=false AND a real key to enable
# live calls. NEVER commit a real key — .env is gitignored.
OPENAI_MOCK=true
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=30

# Trend Radar (Phase 6) — niche trend discovery.
# MOCK-FIRST: leave TREND_MOCK=true and the app uses the deterministic offline
# mock provider. Set TREND_MOCK=false to enable a real provider:
#   TREND_PROVIDER=youtube       → needs YOUTUBE_API_KEY (Data API v3)
#   TREND_PROVIDER=google_trends → public daily-trends endpoint, no key
# A missing/misconfigured real provider falls back to mock (fail-safe).
TREND_MOCK=true
# TREND_PROVIDER=youtube
# YOUTUBE_API_KEY=
# TREND_CACHE_TTL=21600
# TREND_LIMIT=8
# TREND_TIMEOUT=15
